{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resource-ops v1 catalog document",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "resource-ops/v1"},
    "kind": {"enum": ["Catalog", "Server", "Endpoint", "Action", "Page"]},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "Catalog"}}}, "then": {"properties": {"spec": {"$ref": "#/$defs/catalog"}}}},
    {"if": {"properties": {"kind": {"const": "Server"}}}, "then": {"properties": {"spec": {"$ref": "#/$defs/server"}}}},
    {"if": {"properties": {"kind": {"const": "Endpoint"}}}, "then": {"properties": {"spec": {"$ref": "#/$defs/endpoint"}}}},
    {"if": {"properties": {"kind": {"const": "Action"}}}, "then": {"properties": {"spec": {"$ref": "#/$defs/action"}}}},
    {"if": {"properties": {"kind": {"const": "Page"}}}, "then": {"properties": {"spec": {"$ref": "#/$defs/page"}}}}
  ],
  "$defs": {
    "name": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "title"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"}
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["resources"],
      "properties": {
        "resources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^catalog/(servers|endpoints|actions|pages)/[a-z][a-z0-9.-]*\\.yaml$"}
        }
      }
    },
    "server": {
      "type": "object", "additionalProperties": false, "required": ["baseUrl"],
      "properties": {
        "baseUrl": {"type": "string", "pattern": "^https?://[^\\s]+$"},
        "description": {"$ref": "#/$defs/text"}
      }
    },
    "valueSchema": {
      "description": "Inline JSON Schema subset: explicit types, closed objects, homogeneous arrays, scalar constraints. No refs or composition in v1.",
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["object", "array", "string", "integer", "number", "boolean", "null"]},
        "description": {"$ref": "#/$defs/text"},
        "properties": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"not": {"const": "*"}},
          "additionalProperties": {"$ref": "#/$defs/valueSchema"}
        },
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "additionalProperties": {"const": false},
        "items": {"$ref": "#/$defs/valueSchema"},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
        "const": {},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "object"}}}, "then": {"required": ["properties", "additionalProperties"]}, "else": {"not": {"anyOf": [{"required": ["properties"]}, {"required": ["required"]}, {"required": ["additionalProperties"]}]}}},
        {"if": {"properties": {"type": {"const": "array"}}}, "then": {"required": ["items"]}, "else": {"not": {"anyOf": [{"required": ["items"]}, {"required": ["minItems"]}, {"required": ["maxItems"]}]}}},
        {"if": {"properties": {"type": {"not": {"const": "string"}}}}, "then": {"not": {"anyOf": [{"required": ["minLength"]}, {"required": ["maxLength"]}]}}},
        {"if": {"properties": {"type": {"not": {"enum": ["integer", "number"]}}}}, "then": {"not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}}}
      ]
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["in", "name", "required", "schema"],
      "properties": {
        "in": {"enum": ["path", "query", "header", "cookie"]},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
        "required": {"type": "boolean"},
        "schema": {"$ref": "#/$defs/valueSchema"}
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["server", "method", "path", "request", "responses"],
      "properties": {
        "server": {"$ref": "#/$defs/name"},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
        "path": {"type": "string", "pattern": "^/(?!/)[^?#\\s]*$"},
        "request": {
          "type": "object", "additionalProperties": false, "required": ["parameters"],
          "properties": {
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
            "body": {
              "type": "object", "additionalProperties": false, "required": ["required", "schema"],
              "properties": {"required": {"type": "boolean"}, "schema": {"$ref": "#/$defs/valueSchema"}}
            }
          }
        },
        "responses": {
          "type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[1-5][0-9]{2}$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["description", "schema"],
            "properties": {"description": {"$ref": "#/$defs/text"}, "schema": {"$ref": "#/$defs/valueSchema"}}
          }
        }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["in", "name"],
      "properties": {
        "in": {"enum": ["path", "query", "header", "cookie"]},
        "name": {"$ref": "#/$defs/text"},
        "source": {"enum": ["input", "subject.id", "subject.email", "subject.nickname", "subject.organization.code"]},
        "value": {}
      },
      "oneOf": [{"required": ["source"]}, {"required": ["value"]}]
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["endpoint", "request", "responses"],
      "properties": {
        "endpoint": {"$ref": "#/$defs/name"},
        "request": {
          "type": "object", "additionalProperties": false, "required": ["parameters"],
          "properties": {
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
            "body": {
              "type": "object", "additionalProperties": false, "required": ["source"],
              "properties": {"source": {"const": "input"}}
            }
          }
        },
        "responses": {
          "type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[1-5][0-9]{2}$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["fields"],
            "properties": {
              "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(|/.*)$"}}
            }
          }
        }
      }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["path", "actions"],
      "properties": {
        "path": {"type": "string", "pattern": "^/(?!/)[^?#\\s]*$"},
        "parent": {"$ref": "#/$defs/name"},
        "actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
      }
    }
  }
}
