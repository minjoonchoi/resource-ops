{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resource-ops v1 catalog document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "resource-ops/v1"
    },
    "kind": {
      "enum": [
        "Catalog",
        "Service",
        "Action",
        "Page"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Catalog"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/catalog"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Action"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Page"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Service"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/service"
          },
          "metadata": {
            "required": [
              "organization"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "httpMethod": {
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
    },
    "endpointPath": {
      "type": "string",
      "pattern": "^/(?!/)[^?#\\s]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "organization": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(services|actions|pages)/[a-z][a-z0-9.-]*\\.yaml$"
          }
        }
      }
    },
    "parameterOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "name"
      ],
      "properties": {
        "in": {
          "enum": [
            "path",
            "query",
            "header",
            "cookie"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "enum": [
            "subject.id",
            "subject.email",
            "subject.nickname",
            "subject.organization.code"
          ]
        },
        "value": {}
      },
      "oneOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "value"
          ]
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "method",
        "path"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/name"
        },
        "method": {
          "$ref": "#/$defs/httpMethod"
        },
        "path": {
          "$ref": "#/$defs/endpointPath"
        }
      }
    },
    "pageAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/name"
        },
        "overrides": {
          "$ref": "#/$defs/endpointOverrides"
        }
      }
    },
    "endpointOverrides": {
      "description": "Sparse changes for one Page/Action usage. Omitted values inherit the Endpoint contract.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameters"
          ],
          "properties": {
            "parameters": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/parameterOverride"
              }
            }
          }
        },
        "responses": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^([1-5][0-9]{2}|[1-5]XX|default)$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(|/.*)$"
                }
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "actions"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^?#\\s]*$"
        },
        "parent": {
          "$ref": "#/$defs/name"
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pageAction"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "endpoints",
        "openapi"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^openapi/[^/]+/[a-z][a-z0-9.-]*\\.json$"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metadata",
              "method",
              "path"
            ],
            "properties": {
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "organization"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  },
                  "organization": {
                    "$ref": "#/$defs/text"
                  },
                  "description": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              "method": {
                "$ref": "#/$defs/httpMethod"
              },
              "path": {
                "$ref": "#/$defs/endpointPath"
              }
            }
          }
        },
        "openapi": {
          "type": "object"
        }
      }
    }
  }
}
