{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resource-ops file manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(services|actions|pages)/[a-z][a-z0-9.-]*\\.yaml$"
      }
    }
  }
}
